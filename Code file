];
const DEFAULT_COURSES = ['C++ Programming', 'Database Systems', 'Computer Networks', 'Discrete Math', 'Calculus'];
const DEFAULT_LINKS = [
  { id: uid(), label: 'LMS Submission Portal', url: 'https://lms.university.edu' },
  { id: uid(), label: 'Lab Instructor Email', url: 'mailto:instructor@university.edu' },
];
const CHECKLIST_TEMPLATES = {
  'Assignment': ['Code comments added', 'Report / PDF generated', 'Files compressed into .zip'],
  'Lab Report': ['Code comments added', 'Output screenshots included', 'PDF report generated', 'ZIP file compressed'],
  'Viva': ['Concepts revised', 'Viva code / output ready', 'Likely questions listed'],
  'Exam': ['Syllabus reviewed', 'Practice problems solved', 'Formula sheet prepared'],
};

const STORAGE_KEY = 'cs-academic-tracker:data';

/* ============================= STATE ============================= */
let state = {
  tasks: [],
  courses: [],
  links: [],
  view: 'dashboard',
  ui: {
    sidebarOpen: false,
    search: '',
    filterCourse: 'all',
    filterStatus: 'all',
    filterType: 'all',
    filterPriority: 'all',
    modal: null,        // { mode: 'add'|'edit', taskId }
    detailTaskId: null,
    confirmDeleteId: null,
    toast: null,
  },
};

function uid() { return 'id-' + Math.random().toString(36).slice(2, 10) + Date.now().toString(36); }

function defaultState() {
  return {
    tasks: [],
    courses: DEFAULT_COURSES.map((name, i) => ({ id: uid(), name, colorIdx: i % COURSE_PALETTE.length })),
    links: DEFAULT_LINKS,
    view: 'dashboard',
    ui: { sidebarOpen: false, search: '', filterCourse: 'all', filterStatus: 'all', filterType: 'all', filterPriority: 'all', modal: null, detailTaskId: null, confirmDeleteId: null, toast: null },
  };
}

/* ============================= PERSISTENCE (browser localStorage) ============================= */
async function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      const parsed = JSON.parse(raw);
      state = Object.assign(defaultState(), parsed);
      state.ui = defaultState().ui; // never persist transient ui
    } else {
      state = defaultState();
    }
  } catch (e) {
    state = defaultState();
  }
}

let saveTimer = null;
function persist() {
  clearTimeout(saveTimer);
  saveTimer = setTimeout(() => {
    try {
      const { ui, ...toSave } = state;
      localStorage.setItem(STORAGE_KEY, JSON.stringify(toSave));
    } catch (e) {
      showToast('Could not save — your changes may not persist.', 'error');
    }
  }, 120);
}

/* ============================= UTIL ============================= */
function esc(str) {
  if (str === null || str === undefined) return '';
  return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function fmtDate(iso) {
  if (!iso) return '—';
  const d = new Date(iso);
  if (isNaN(d)) return '—';
  return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) + ' · ' + d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
}
function fmtDateShort(iso) {
  const d = new Date(iso);
  if (isNaN(d)) return '—';
  return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
}
function daysUntil(iso) {
  const now = new Date();
  const d = new Date(iso);
  return (d - now) / (1000 * 60 * 60 * 24);
}
function courseStyle(courseName) {
  const c = state.courses.find((c) => c.name === courseName);
  const idx = c ? c.colorIdx : Math.abs(hashCode(courseName || '')) % COURSE_PALETTE.length;
  return COURSE_PALETTE[idx % COURSE_PALETTE.length];
}
function hashCode(s) { let h = 0; for (let i = 0; i < s.length; i++) { h = (h << 5) - h + s.charCodeAt(i); h |= 0; } return h; }
function typeIcon(type) {
  return { Assignment: 'list', 'Lab Report': 'flask', Viva: 'book', Exam: 'clock' }[type] || 'list';
}
function activeTasks() { return state.tasks.filter((t) => t.status !== 'done'); }
function showToast(msg, kind = 'ok') {
  state.ui.toast = { msg, kind, id: uid() };
  render();
  clearTimeout(showToast._t);
  showToast._t = setTimeout(() => { state.ui.toast = null; render(); }, 2600);
}

/* ============================= MUTATIONS ============================= */
function upsertTask(data, id) {
  if (id) {
    const idx = state.tasks.findIndex((t) => t.id === id);
    if (idx > -1) state.tasks[idx] = { ...state.tasks[idx], ...data };
  } else {
    const checklist = (CHECKLIST_TEMPLATES[data.type] || []).map((label) => ({ id: uid(), label, done: false }));
    state.tasks.unshift({
      id: uid(), status: 'todo', createdAt: new Date().toISOString(), checklist, ...data,
    });
  }
  persist();
}
function deleteTask(id) {
  state.tasks = state.tasks.filter((t) => t.id !== id);
  state.ui.confirmDeleteId = null;
  if (state.ui.detailTaskId === id) state.ui.detailTaskId = null;
  persist();
  showToast('Task deleted.');
}
function setStatus(id, status) {
  const t = state.tasks.find((t) => t.id === id);
  if (t) { t.status = status; persist(); }
}
function toggleChecklistItem(taskId, itemId) {
  const t = state.tasks.find((t) => t.id === taskId);
  if (!t) return;
  const item = t.checklist.find((c) => c.id === itemId);
  if (item) { item.done = !item.done; persist(); }
}
function addChecklistItem(taskId, label) {
  const t = state.tasks.find((t) => t.id === taskId);
  if (!t || !label.trim()) return;
  t.checklist.push({ id: uid(), label: label.trim(), done: false });
  persist();
}
function removeChecklistItem(taskId, itemId) {
  const t = state.tasks.find((t) => t.id === taskId);
  if (!t) return;
  t.checklist = t.checklist.filter((c) => c.id !== itemId);
  persist();
}
function addCourse(name) {
  if (!name.trim()) return;
  if (state.courses.some((c) => c.name.toLowerCase() === name.trim().toLowerCase())) { showToast('That course already exists.', 'error'); return; }
  state.courses.push({ id: uid(), name: name.trim(), colorIdx: state.courses.length % COURSE_PALETTE.length });
  persist();
}
function removeCourse(id) {
  const c = state.courses.find((c) => c.id === id);
  state.courses = state.courses.filter((c) => c.id !== id);
  persist();
  showToast(c ? `Removed "${c.name}".` : 'Course removed.');
}
function addLink(label, url) {
  if (!label.trim() || !url.trim()) return;
  state.links.push({ id: uid(), label: label.trim(), url: url.trim() });
  persist();
}
function removeLink(id) { state.links = state.links.filter((l) => l.id !== id); persist(); }
function clearAllData() {
  state = defaultState();
  persist();
  showToast('All data cleared.');
}
function loadSampleData() {
  const c = (name) => state.courses.find((x) => x.name === name)?.name || state.courses[0]?.name;
  const now = Date.now();
  const day = 86400000;
  const mk = (title, course, type, priority, dueInDays, notes, status = 'todo') => ({
    id: uid(), title, course, type, priority, status, notes,
    dueDate: new Date(now + dueInDays * day).toISOString().slice(0, 16),
    createdAt: new Date().toISOString(),
    checklist: (CHECKLIST_TEMPLATES[type] || []).map((label) => ({ id: uid(), label, done: Math.random() > 0.6 })),
  });
  state.tasks = [
    mk('C++ Inheritance Lab Assignment', c('C++ Programming'), 'Lab Report', 'High', 1, 'Submit as .zip with source + output screenshots. Include comments explaining virtual functions.'),
    mk('ER Diagram — Library Management System', c('Database Systems'), 'Assignment', 'Medium', 3, 'Draw ERD in draw.io, export as PDF, include cardinality notes.'),
    mk('Viva — Data Structures (Linked Lists)', c('C++ Programming'), 'Viva', 'High', 2, 'Prepare traversal, insertion, deletion code. Expect questions on time complexity.'),
    mk('Subnetting Practice Sheet', c('Computer Networks'), 'Lab Report', 'Low', 6, 'Show full working for each subnet calculation.'),
    mk('Discrete Math Problem Set 4', c('Discrete Math'), 'Assignment', 'Medium', 5, 'Chapters 6–7: relations and functions.'),
    mk('Calculus Midterm', c('Calculus'), 'Exam', 'High', 9, 'Covers integration techniques and series convergence.'),
    mk('Normalization Lab (3NF)', c('Database Systems'), 'Lab Report', 'Medium', -1, 'Submitted via portal.', 'done'),
    mk('Socket Programming Lab', c('Computer Networks'), 'Lab Report', 'High', 0, 'TCP client-server chat app in C++. Demo required.', 'in-progress'),
  ];
  persist();
  showToast('Sample data loaded.');
}

/* ============================= DERIVED DATA ============================= */
function filteredTasks(scope) {
  let list = [...state.tasks];
  if (scope === 'labs') list = list.filter((t) => t.type === 'Lab Report' || t.type === 'Viva');
  if (scope === 'assignments') list = list.filter((t) => t.type === 'Assignment' || t.type === 'Exam');
  const { search, filterCourse, filterStatus, filterType, filterPriority } = state.ui;
  if (search.trim()) {
    const q = search.toLowerCase();
    list = list.filter((t) => t.title.toLowerCase().includes(q) || (t.course || '').toLowerCase().includes(q) || (t.notes || '').toLowerCase().includes(q));
  }
  if (filterCourse !== 'all') list = list.filter((t) => t.course === filterCourse);
  if (filterStatus !== 'all') list = list.filter((t) => t.status === filterStatus);
  if (filterType !== 'all') list = list.filter((t) => t.type === filterType);
  if (filterPriority !== 'all') list = list.filter((t) => t.priority === filterPriority);
  return list;
}
function stats() {
  const active = activeTasks();
  const pendingLabs = state.tasks.filter((t) => t.type === 'Lab Report' && t.status !== 'done').length;
  const upcomingVivas = state.tasks.filter((t) => t.type === 'Viva' && t.status !== 'done' && daysUntil(t.dueDate) <= 7 && daysUntil(t.dueDate) >= -0.01).length;
  const completed = state.tasks.filter((t) => t.status === 'done').length;
  return { totalActive: active.length, pendingLabs, upcomingVivas, completed };
}

