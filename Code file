    </div>
    <div class="flex flex-wrap gap-2">
      ${selectField('filterCourse', ['all', ...courseOptions], state.ui.filterCourse, 'All Courses')}
      ${selectField('filterType', ['all', ...typeOptions], state.ui.filterType, scope === 'labs' ? 'Lab Reports & Vivas' : scope === 'assignments' ? 'Assignments & Exams' : 'All Types')}
