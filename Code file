  </select>`;
}

function renderTaskCard(t) {
  const p = PRIORITY_STYLE[t.priority];
  const cs = courseStyle(t.course);
  const d = daysUntil(t.dueDate);
  const overdue = d < 0 && t.status !== 'done';
  const done = t.checklist.filter((c) => c.done).length;
  const total = t.checklist.length;
  return `
  <div draggable="true" data-drag-id="${t.id}" data-action="open-detail" data-id="${t.id}"
    class="group rounded-lg border ${overdue ? 'border-red-500/30' : 'border-ink-700'} bg-ink-900 p-3.5 cursor-pointer card-hover">
    <div class="flex items-start justify-between gap-2 mb-2">
      <span class="inline-flex items-center gap-1 text-[10px] px-1.5 py-0.5 rounded-full border ${cs.border} ${cs.bg} ${cs.text} truncate max-w-[65%]">${esc(t.course || 'No course')}</span>
      <span class="text-[10px] font-mono px-1.5 py-0.5 rounded-full border ${p.border} ${p.bg} ${p.text} shrink-0">${t.priority}</span>
    </div>
    <p class="text-sm font-medium text-slate-200 leading-snug mb-2 group-hover:text-cyan-300 transition">${esc(t.title)}</p>
    <div class="flex items-center gap-1.5 text-[11px] text-slate-500 mb-2">
      ${icon(typeIcon(t.type), 'w-3.5 h-3.5')} ${esc(t.type)}
    </div>
    <div class="flex items-center justify-between text-[11px]">
      <span class="flex items-center gap-1 font-mono ${overdue ? 'text-red-400' : 'text-slate-500'}">${icon('clock', 'w-3 h-3')} ${fmtDate(t.dueDate)}</span>
      ${total ? `<span class="font-mono text-slate-600">${done}/${total}</span>` : ''}
    </div>
    ${t.status !== 'done' ? `
    <div class="mt-3 pt-3 border-t border-ink-800 flex gap-1.5">
      ${col_button_row(t)}
    </div>` : ''}
  </div>`;
}

function col_button_row(t) {
  const order = ['todo', 'in-progress', 'done'];
  const idx = order.indexOf(t.status);
  let btns = '';
  if (idx > 0) btns += `<button data-action="set-status" data-id="${t.id}" data-status="${order[idx - 1]}" class="flex-1 text-[11px] py-1.5 rounded-md border border-ink-700 text-slate-400 hover:text-slate-200 hover:border-ink-600 transition">${icon('chevron', 'w-3 h-3 rotate-180 inline')} Back</button>`;
  if (idx < order.length - 1) btns += `<button data-action="set-status" data-id="${t.id}" data-status="${order[idx + 1]}" class="flex-1 text-[11px] py-1.5 rounded-md border border-cyan-500/30 text-cyan-300 hover:bg-cyan-500/10 transition">${order[idx+1]==='done'?'Complete':'Start'} ${icon('chevron', 'w-3 h-3 inline')}</button>`;
  return btns;
}

/* ============================= ANALYTICS ============================= */
function renderAnalytics() {
  if (state.tasks.length === 0) {
    return `<div>${renderEmptyHero()}</div>`;
  }
  const total = state.tasks.length;
  const done = state.tasks.filter((t) => t.status === 'done').length;
  const rate = total ? Math.round((done / total) * 100) : 0;

  const perCourse = state.courses.map((c) => ({
    name: c.name, colorIdx: c.colorIdx,
    count: state.tasks.filter((t) => t.course === c.name).length,
  })).filter((c) => c.count > 0).sort((a, b) => b.count - a.count);
  const maxCourse = Math.max(1, ...perCourse.map((c) => c.count));

  const perPriority = PRIORITIES.map((p) => ({ p, count: state.tasks.filter((t) => t.priority === p && t.status !== 'done').length }));
  const maxPriority = Math.max(1, ...perPriority.map((p) => p.count));

  const days = Array.from({ length: 7 }, (_, i) => {
    const d = new Date(); d.setHours(0,0,0,0); d.setDate(d.getDate() + i);
    const count = state.tasks.filter((t) => {
      const td = new Date(t.dueDate);
      return td.toDateString() === d.toDateString() && t.status !== 'done';
    }).length;
    return { label: d.toLocaleDateString(undefined, { weekday: 'short' }), count };
  });
  const maxDay = Math.max(1, ...days.map((d) => d.count));

  const perType = TASK_TYPES.map((ty) => ({ ty, count: state.tasks.filter((t) => t.type === ty).length }));

  return `
  <div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-xl border border-ink-700 bg-ink-900 p-5 md:col-span-1 flex flex-col items-center justify-center text-center">
        <div class="relative w-28 h-28 mb-3">
          <svg viewBox="0 0 36 36" class="w-28 h-28 -rotate-90">
            <circle cx="18" cy="18" r="15.5" fill="none" stroke="#161f2d" stroke-width="3.5"/>
            <circle cx="18" cy="18" r="15.5" fill="none" stroke="url(#g1)" stroke-width="3.5" stroke-linecap="round"
              stroke-dasharray="${rate * 0.974}, 200" />
            <defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#22d3ee"/><stop offset="100%" stop-color="#3b82f6"/></linearGradient></defs>
          </svg>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-2xl font-bold font-mono text-slate-100">${rate}%</span>
          </div>
        </div>
        <p class="text-sm font-semibold text-slate-200">Completion Rate</p>
        <p class="text-xs text-slate-500 mt-1">${done} of ${total} tasks completed</p>
      </div>

      <div class="rounded-xl border border-ink-700 bg-ink-900 p-5 md:col-span-2">
        <h3 class="text-sm font-semibold text-slate-200 mb-4">Next 7 Days — Active Load</h3>
        <div class="flex items-end gap-3 h-32">
          ${days.map((d) => `
            <div class="flex-1 flex flex-col items-center justify-end gap-2 h-full">
              <span class="text-[11px] font-mono text-slate-400">${d.count || ''}</span>
              <div class="w-full rounded-md bg-gradient-to-t from-cyan-500 to-blue-500 ${d.count ? '' : 'opacity-10'}" style="height:${Math.max(6, (d.count / maxDay) * 100)}%"></div>
              <span class="text-[10px] text-slate-500">${d.label}</span>
            </div>`).join('')}
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="rounded-xl border border-ink-700 bg-ink-900 p-5">
        <h3 class="text-sm font-semibold text-slate-200 mb-4">Tasks per Course</h3>
        <div class="space-y-3">
          ${perCourse.length ? perCourse.map((c) => {
            const st = COURSE_PALETTE[c.colorIdx % COURSE_PALETTE.length];
            return `
            <div>
