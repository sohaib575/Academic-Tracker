  html, body { background: #05080d; }
  body { font-feature-settings: "tnum" 1, "ss01" 1; }

  .font-mono-num { font-variant-numeric: tabular-nums; }

  @keyframes fadein { from { opacity:0; transform: translateY(4px);} to { opacity:1; transform: translateY(0);} }
  .anim-in { animation: fadein .22s ease-out; }

  @keyframes pulse-dot { 0%,100% { opacity:1;} 50% { opacity:.35; } }
  .pulse-dot { animation: pulse-dot 2s ease-in-out infinite; }

  input[type="checkbox"].chk {
    appearance: none; -webkit-appearance:none;
    width: 18px; height: 18px; border-radius: 5px;
    border: 1.5px solid #3c4a5c; background: #0e1520;
    display: inline-grid; place-content:center; cursor:pointer; flex-shrink:0;
    transition: all .15s ease;
  }
  input[type="checkbox"].chk:checked {
    background: linear-gradient(135deg,#22d3ee,#3b82f6); border-color: transparent;
  }
  input[type="checkbox"].chk:checked::after {
    content:''; width:5px; height:9px; border: solid #05080d; border-width: 0 2px 2px 0;
    transform: rotate(45deg) translateY(-1px);
  }

  input[type="text"], input[type="datetime-local"], input[type="url"], input[type="search"], textarea, select {
    color-scheme: dark;
  }

  ::placeholder { color: #4a5768; }

  .card-hover { transition: border-color .15s ease, transform .15s ease; }
  .card-hover:hover { border-color: rgba(34,211,238,0.35); }

  .drag-over { outline: 1.5px dashed #22d3ee55; outline-offset: -6px; background: rgba(34,211,238,0.03); }
  .dragging { opacity: .4; }

  .bar-track { background: #0e1520; }

  @media (max-width: 767px) {
    .desktop-only { display: none !important; }
  }
  @media (min-width: 768px) {
    .mobile-only { display: none !important; }
  }



