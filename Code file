/* ============================= EVENTS ============================= */
// All listeners are bound ONCE (below, in bindGlobalEvents) using event delegation
// on the #app container, which itself is never replaced — only its innerHTML changes
// on each render(). This avoids re-attaching duplicate listeners on every render,
// which was the cause of the app slowing down the longer it was used.
function bindGlobalEvents() {
  const app = document.getElementById('app');

  app.addEventListener('click', (e) => {
    const el = e.target.closest('[data-action]');
    if (!el) return;
    const action = el.dataset.action;

    if (action === 'nav') {
      state.view = el.dataset.view;
      state.ui.sidebarOpen = false;
      state.ui.search = ''; state.ui.filterCourse = 'all'; state.ui.filterStatus = 'all'; state.ui.filterType = 'all'; state.ui.filterPriority = 'all';
      render();
    }
    else if (action === 'open-sidebar') { state.ui.sidebarOpen = true; render(); }
    else if (action === 'close-sidebar') { state.ui.sidebarOpen = false; render(); }
    else if (action === 'open-add') { state.ui.modal = { mode: 'add' }; render(); }
    else if (action === 'open-edit') { state.ui.modal = { mode: 'edit', taskId: el.dataset.id }; state.ui.detailTaskId = null; render(); }
    else if (action === 'close-modal') { state.ui.modal = null; render(); }
    else if (action === 'open-detail') { state.ui.detailTaskId = el.dataset.id; state.ui.confirmDeleteId = null; render(); }
    else if (action === 'close-detail') { state.ui.detailTaskId = null; state.ui.confirmDeleteId = null; render(); }
    else if (action === 'ask-delete') { state.ui.confirmDeleteId = el.dataset.id; render(); }
    else if (action === 'cancel-delete') { state.ui.confirmDeleteId = null; render(); }
    else if (action === 'delete-task') { deleteTask(el.dataset.id); render(); }
    else if (action === 'set-status') { setStatus(el.dataset.id, el.dataset.status); render(); }
    else if (action === 'toggle-check') { toggleChecklistItem(el.dataset.task, el.dataset.item); render(); }
    else if (action === 'remove-check') { removeChecklistItem(el.dataset.task, el.dataset.item); render(); }
    else if (action === 'remove-course') { removeCourse(el.dataset.id); render(); }
    else if (action === 'remove-link') { removeLink(el.dataset.id); render(); }
    else if (action === 'load-sample') { loadSampleData(); render(); }
    else if (action === 'clear-data') {
      if (confirm('This will permanently delete all tasks, courses, and links. Continue?')) { clearAllData(); render(); }
    }
    else if (action === 'export-data') { exportData(); }
  });

  app.addEventListener('change', (e) => {
    const bind = e.target.dataset?.bind;
    if (bind) { state.ui[bind] = e.target.value; render(); }
    if (e.target.dataset?.action === 'import-data') { importData(e.target.files[0]); }
  });

  app.addEventListener('input', (e) => {
    if (e.target.dataset?.bind === 'search') {
      state.ui.search = e.target.value;
      renderInPlaceTaskList();
    }
  });

  app.addEventListener('submit', (e) => {
    e.preventDefault();
    const action = e.target.dataset?.action;
    if (action === 'task-form') {
      const fd = new FormData(e.target);
      const data = {
        title: fd.get('title').trim(),
        course: fd.get('course'),
        type: fd.get('type'),
        priority: fd.get('priority'),
        dueDate: fd.get('dueDate'),
        notes: fd.get('notes').trim(),
      };
      if (!data.title) return;
      const m = state.ui.modal;
      upsertTask(data, m.mode === 'edit' ? m.taskId : null);
      state.ui.modal = null;
      showToast(m.mode === 'edit' ? 'Task updated.' : 'Task added.');
      render();
    } else if (action === 'add-course-form') {
      const fd = new FormData(e.target);
      addCourse(fd.get('courseName'));
      e.target.reset();
      render();
    } else if (action === 'add-link-form') {
      const fd = new FormData(e.target);
      addLink(fd.get('linkLabel'), fd.get('linkUrl'));
      e.target.reset();
      render();
    } else if (action === 'add-check-form') {
      const fd = new FormData(e.target);
      addChecklistItem(e.target.dataset.task, fd.get('itemLabel'));
      render();
    }
  });

  // Drag and drop — also delegated, so it works for cards created by any future render
  // without needing to re-attach listeners each time.
  let dragId = null;
  app.addEventListener('dragstart', (e) => {
    const card = e.target.closest('[data-drag-id]');
    if (!card) return;
    dragId = card.dataset.dragId;
    card.classList.add('dragging');
    e.dataTransfer.setData('text/plain', dragId);
  });
  app.addEventListener('dragend', (e) => {
    const card = e.target.closest('[data-drag-id]');
    if (card) card.classList.remove('dragging');
    app.querySelectorAll('.drag-over').forEach((z) => z.classList.remove('drag-over'));
  });
  app.addEventListener('dragover', (e) => {
    const zone = e.target.closest('[data-dropzone]');
    if (!zone) return;
    e.preventDefault();
    zone.classList.add('drag-over');
  });
  app.addEventListener('dragleave', (e) => {
    const zone = e.target.closest('[data-dropzone]');
    if (zone && !zone.contains(e.relatedTarget)) zone.classList.remove('drag-over');
  });
  app.addEventListener('drop', (e) => {
    const zone = e.target.closest('[data-dropzone]');
    if (!zone) return;
    e.preventDefault();
    zone.classList.remove('drag-over');
    const taskId = e.dataTransfer.getData('text/plain') || dragId;
    if (taskId) { setStatus(taskId, zone.dataset.dropzone); render(); }
  });
}

// Lightweight re-render of just the list/board portion while typing search, to preserve input focus
function renderInPlaceTaskList() {
  const main = document.querySelector('main');
  if (!main) return render();
  main.innerHTML = renderView();
  const input = main.querySelector('[data-bind="search"]');
  if (input) { input.focus(); input.setSelectionRange(input.value.length, input.value.length); }
}

/* ============================= IMPORT / EXPORT ============================= */
function exportData() {
  const { ui, ...toSave } = state;
  const blob = new Blob([JSON.stringify(toSave, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'cs-academic-tracker-export.json'; a.click();
  URL.revokeObjectURL(url);
}
function importData(file) {
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const parsed = JSON.parse(reader.result);
      if (!Array.isArray(parsed.tasks)) throw new Error('bad shape');
      state = Object.assign(defaultState(), parsed);
      state.ui = defaultState().ui;
      persist();
      showToast('Data imported successfully.');
      render();
    } catch (e) {
      showToast('Could not import — invalid file.', 'error');
    }
  };
  reader.readAsText(file);
}

/* ============================= BOOT ============================= */
(async function boot() {
  await loadState();
  document.getElementById('boot').remove();
  document.getElementById('app').classList.remove('hidden');
  bindGlobalEvents();
  render();
})();
